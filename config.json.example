{
    "ingest_port": 8765,
    "web_port": 443,
    "offline_timeout": 5.0,
    "ingest_token": "",
    "devices_file": "devices.json",
    "max_devices": 16,
    "pair_enabled": true,
    "pair_ttl": 600.0,
    "pair_max_pending": 5,
    "ingest_max_conns": 64,
    "ingest_hello_timeout": 10.0,
    "ingest_idle_timeout": 60.0,
    "max_viewers": 50,
    "sys_history_max": 720,
    "log_dir": "logs",
    "log_retention_days": 190,
    "sys_db_path": "sys_logs/sys_history.sqlite3",
    "sys_persist_interval": 60.0,
    "sys_retention_days": 7,
    "alarm_db_path": "alarm_logs/alarm_history.sqlite3",
    "alarm_retention_days": 7,
    "tls_cert": "certs/server.pem",
    "tls_key": "certs/server.key",
    "auth_enabled": true,
    "accounts_file": "accounts.json",
    "session_idle_minutes": 30.0,
    "session_absolute_hours": 12.0,
    "session_max": 200
}
