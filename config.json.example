{
    "ingest_port": 8765,
    "web_port": 8080,
    "offline_timeout": 5.0,
    "ingest_token": "",
    "max_devices": 16,
    "sys_history_max": 720,
    "sys_log_dir": "sys_logs",
    "sys_csv_interval": 60.0,
    "tls_cert": "certs/server.pem",
    "tls_key": "certs/server.key",
    "auth_enabled": true,
    "accounts_file": "accounts.json",
    "session_idle_minutes": 30.0
}
