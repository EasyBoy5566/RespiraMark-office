{
    "ingest_port": 8765,
    "web_port": 8080,
    "offline_timeout": 5.0,
    "ingest_token": "",
    "devices_file": "devices.json",
    "max_devices": 16,
    "ingest_max_conns": 64,
    "ingest_hello_timeout": 10.0,
    "ingest_idle_timeout": 60.0,
    "max_viewers": 50,
    "sys_history_max": 720,
    "sys_log_dir": "sys_logs",
    "sys_csv_interval": 60.0,
    "alarm_log_dir": "alarm_logs",
    "tls_cert": "certs/server.pem",
    "tls_key": "certs/server.key",
    "auth_enabled": true,
    "accounts_file": "accounts.json",
    "session_idle_minutes": 30.0,
    "session_absolute_hours": 12.0,
    "session_max": 200,
    "log_dir": "logs",
    "auth_backend": "local",
    "ldap_server": "ldaps://ad.example.org",
    "ldap_bind_template": "{username}@example.org",
    "ldap_use_ssl": true,
    "ldap_ca": "certs/hospital-ca.pem",
    "ldap_timeout": 5.0
}
